---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Divider from '../components/Divider.astro';
import { sections } from '../lib/sections';

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const section = sections[entry.data.section];
const date = entry.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="entry">
    <header class="entry-header">
      <a class="back-link" href={`/${entry.data.section}/`}>← {section.label}</a>
      <h1>{entry.data.title}</h1>
      <p class="entry-description">{entry.data.description}</p>
      <div class="entry-meta">
        <time datetime={entry.data.date.toISOString()}>{date}</time>
        {entry.data.location && <span>{entry.data.location}</span>}
      </div>
    </header>
    <Divider variant="line-brown" />
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
