---
import Header from '../components/Header.astro';
import Divider from '../components/Divider.astro';
import ThemePicker from '../components/ThemePicker.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = '写作、笔记、旅行、照片与音乐。',
} = Astro.props;
const pageTitle = title ? `${title} · W.` : 'W.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme="minimal">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      (() => {
        const themes = ['minimal', 'magazine', 'terminal', 'cyber', 'island', 'wilds', 'persona'];
        try {
          const saved = localStorage.getItem('site-theme');
          if (saved && themes.includes(saved)) document.documentElement.dataset.theme = saved;
        } catch {
          // Keep the default theme when storage is unavailable.
        }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Divider variant="line-brown" />
    <footer>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} W.</span>
        <span>写作与生活记录</span>
      </div>
      <div class="footer-settings">
        <ThemePicker />
      </div>
    </footer>
  </body>
</html>
