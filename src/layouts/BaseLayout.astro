---
import Header from '../components/Header.astro';
import Divider from '../components/Divider.astro';
import ThemePicker from '../components/ThemePicker.astro';
import '../styles/aether-themes.css';
import '../styles/site-assets.css';
import aetherConfig from '../../aether.config.mjs';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = '写作、笔记、旅行、照片与音乐。',
} = Astro.props;
const pageTitle = title ? `${title} · W.` : 'W.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const enabledThemes = aetherConfig.themes;
const defaultTheme = enabledThemes.includes(aetherConfig.defaultTheme)
  ? aetherConfig.defaultTheme
  : enabledThemes[0];
---

<!doctype html>
<html lang="zh-CN" data-theme={defaultTheme} data-theme-values={JSON.stringify(enabledThemes)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      (() => {
        const themes = JSON.parse(document.documentElement.dataset.themeValues ?? '[]');
        try {
          const saved = localStorage.getItem('site-theme');
          if (saved && themes.includes(saved)) document.documentElement.dataset.theme = saved;
        } catch {
          // Keep the default theme when storage is unavailable.
        }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Divider variant="line-brown" />
    <footer>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} W.</span>
        <div class="footer-meta-end">
          <span>记录生活的美好</span>
          <div class="footer-settings">
            <ThemePicker />
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
