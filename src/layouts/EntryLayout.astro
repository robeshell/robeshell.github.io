---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Divider from '../components/Divider.astro';
import { sections } from '../lib/sections';
import { buildTopicView, getEntries, type Entry } from '../lib/content';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const section = sections[entry.data.section];
const date = entry.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const entryHref = (item: Entry) => `/${item.data.section}/${item.id}/`;

// Topic context: which chapter this entry belongs to and its neighbours in reading order.
const topic = entry.data.topic ? await getEntry(entry.data.topic) : undefined;
const topicView = topic ? buildTopicView(topic, await getEntries()) : undefined;
const chapter = topicView?.chapters.find((item) => item.key === entry.data.chapter);
const position = topicView ? topicView.sequence.findIndex((item) => item.id === entry.id) : -1;
const prev = position > 0 ? topicView?.sequence[position - 1] : undefined;
const next = position >= 0 ? topicView?.sequence[position + 1] : undefined;
const topicHref = topic ? `/topics/${topic.id}/` : '';
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="entry" data-path={`~/${entry.data.section}/${entry.id}.md`} data-section={section.label}>
    <header class="entry-header">
      <a class="back-link" href={`/${entry.data.section}/`}><span class="back-arrow" aria-hidden="true">← </span>{section.label}</a>
      {topic && (
        <a class="topic-badge" href={topicHref}>
          <span class="topic-badge__label">专题</span>
          <span class="topic-badge__title">{topic.data.title}</span>
          {chapter && <span class="topic-badge__chapter">第 {chapter.number} 章 · {chapter.title}</span>}
        </a>
      )}
      <h1>{entry.data.title}</h1>
      <p class="entry-description">{entry.data.description}</p>
      <div class="entry-meta">
        <time datetime={entry.data.date.toISOString()}>{date}</time>
        {entry.data.location && <span>{entry.data.location}</span>}
        {entry.data.draft && <span class="entry-draft">草稿 · 仅本地可见</span>}
      </div>
    </header>
    <Divider variant="line-brown" />
    <div class="prose">
      <slot />
    </div>
    {topic && (
      <nav class="topic-pager" aria-label={`${topic.data.title}专题导航`}>
        {prev ? (
          <a class="topic-pager__link topic-pager__link--prev" href={entryHref(prev)} rel="prev">
            <small>上一篇</small><span>{prev.data.title}</span>
          </a>
        ) : <span class="topic-pager__link topic-pager__link--empty"></span>}
        <a class="topic-pager__home" href={topicHref}>{topic.data.title} · 目录</a>
        {next ? (
          <a class="topic-pager__link topic-pager__link--next" href={entryHref(next)} rel="next">
            <small>下一篇</small><span>{next.data.title}</span>
          </a>
        ) : <span class="topic-pager__link topic-pager__link--empty"></span>}
      </nav>
    )}
  </article>
</BaseLayout>
