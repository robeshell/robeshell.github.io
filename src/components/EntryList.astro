---
import CardList from './CardList.astro';
import { sections } from '../lib/sections';
import { getTopics, type Entry } from '../lib/content';

interface Props {
  entries: Entry[];
  showSection?: boolean;
  /** Hide the topic label, e.g. on the topic's own page. */
  showTopic?: boolean;
  emptyText?: string;
}

const { entries, showSection = false, showTopic = true, emptyText } = Astro.props;
const topicTitles = new Map((await getTopics()).map((topic) => [topic.id, topic.data.title]));

const items = entries.map((entry) => ({
  href: `/${entry.data.section}/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  labels: [
    ...(showSection ? [sections[entry.data.section].label] : []),
    ...(showTopic && entry.data.topic ? [topicTitles.get(entry.data.topic.id) ?? entry.data.topic.id] : []),
  ],
  date: entry.data.date,
  draft: entry.data.draft,
}));
---

<CardList items={items} emptyText={emptyText} />
