---
import {
  DIVIDER_LINE_PATH,
  DIVIDER_ORNAMENT_PATH,
  DIVIDER_WAVE_PATH,
} from '../scripts/aether-markup.js';

type DividerVariant = 'line-brown' | 'line-teal' | 'line-yellow' | 'wave-yellow' | 'dashed-brown';

interface Props {
  variant?: DividerVariant;
  class?: string;
}

const { variant = 'line-brown', class: className = '' } = Astro.props;
---

<div class={`island-divider island-divider--${variant} ${className}`.trim()} role="presentation" aria-hidden="true">
  {variant === 'dashed-brown' ? (
    <span class="island-divider-dash"></span>
  ) : variant === 'wave-yellow' ? (
    <svg viewBox="0 0 375 10" preserveAspectRatio="none" aria-hidden="true">
      <path d={DIVIDER_WAVE_PATH} fill="none" stroke="currentColor" stroke-width="2.8" />
    </svg>
  ) : (
    <svg viewBox="0 0 297 14" preserveAspectRatio="none" aria-hidden="true">
      <path d={DIVIDER_LINE_PATH} fill="currentColor" fill-rule="evenodd" />
    </svg>
  )}
  {variant === 'line-brown' && (
    <span class="island-divider-zelda-ornament">
      <svg viewBox="0 0 49.95 25.01" aria-hidden="true">
        <path d={DIVIDER_ORNAMENT_PATH} fill="currentColor" />
      </svg>
      <span class="island-divider-zelda-ornament-line"></span>
      <svg viewBox="0 0 49.95 25.01" aria-hidden="true">
        <path d={DIVIDER_ORNAMENT_PATH} fill="currentColor" />
      </svg>
    </span>
  )}
</div>
