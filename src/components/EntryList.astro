---
import type { CollectionEntry } from 'astro:content';
import { sections } from '../lib/sections';

interface Props {
  entries: CollectionEntry<'entries'>[];
  showSection?: boolean;
}

const { entries, showSection = false } = Astro.props;
---

<ol class="entry-list">
  {entries.map((entry) => (
    <li>
      <a href={`/${entry.data.section}/${entry.id}/`}>
        <h2>{entry.data.title}</h2>
        <span class="entry-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M4 20 20 4M10 4h10v10" />
          </svg>
        </span>
        <span class="entry-arrow entry-arrow--wilds" aria-hidden="true">
          <svg viewBox="0 0 10 18" focusable="false">
            <path d="M9.43536 10.3304L0.651995 17.9138C0.275566 18.1799 -0.100864 17.7808 0.0246125 17.3817L2.00173 12.7766C3.12324 10.1644 3.07997 7.19835 1.88273 4.61997L0.0246125 0.618326C0.0174314 0.595483 0.0118941 0.572641 0.00790677 0.549923C-0.057777 0.175692 0.297109 -0.164701 0.651995 0.0861556L9.43536 7.66958C10.1882 8.46783 10.1882 9.66521 9.43536 10.3304Z" />
          </svg>
        </span>
        <div class="list-meta">
          {showSection && <span>{sections[entry.data.section].label}</span>}
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
          </time>
        </div>
        <p>{entry.data.description}</p>
      </a>
    </li>
  ))}
</ol>
