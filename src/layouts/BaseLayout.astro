---
import Header from '../components/Header.astro';
import Divider from '../components/Divider.astro';
import ThemePicker from '../components/ThemePicker.astro';
// Self-hosted open-licensed fonts (OFL-1.1). The small Latin families ship in the main bundle;
// each CJK family is ~30 KB of @font-face rules, so those load per theme (see the inline script below).
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/nunito';
import '@fontsource-variable/cinzel';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import cjkSansCss from '@fontsource-variable/noto-sans-sc/index.css?url';
import cjkSerifCss from '@fontsource-variable/noto-serif-sc/index.css?url';
import cjkRoundCss from '@chinese-fonts/mkwtyt/dist/MaoKenTangYuan/result.css?url';
import '../styles/aether-themes.css';
import '../styles/site-assets.css';
import aetherConfig from '../../aether.config.mjs';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = '写作、笔记、旅行、照片与音乐。',
} = Astro.props;
const pageTitle = title ? `${title} · W.` : 'W.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const enabledThemes = aetherConfig.themes;
const cjkFontCss = { sans: cjkSansCss, serif: cjkSerifCss, round: cjkRoundCss };
// Which CJK families each theme actually renders (mirrors the --ff-* stacks used in its CSS).
const themeCjkFonts: Record<string, (keyof typeof cjkFontCss)[]> = {
  minimal: ['sans'],
  magazine: ['serif', 'sans'],
  terminal: ['sans'],
  cyber: ['sans'],
  island: ['round'],
  wilds: ['serif', 'sans'],
  persona: ['sans', 'serif'],
};
const fontManifest = Object.fromEntries(
  enabledThemes.map((theme) => [theme, (themeCjkFonts[theme] ?? ['sans']).map((key) => cjkFontCss[key])]),
);
const defaultTheme = enabledThemes.includes(aetherConfig.defaultTheme)
  ? aetherConfig.defaultTheme
  : enabledThemes[0];
---

<!doctype html>
<html lang="zh-CN" data-theme={defaultTheme} data-theme-values={JSON.stringify(enabledThemes)} data-theme-fonts={JSON.stringify(fontManifest)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themes = JSON.parse(root.dataset.themeValues ?? '[]');
        const fonts = JSON.parse(root.dataset.themeFonts ?? '{}');
        try {
          const saved = localStorage.getItem('site-theme');
          if (saved && themes.includes(saved)) root.dataset.theme = saved;
        } catch {
          // Keep the default theme when storage is unavailable.
        }
        // Attach only the CJK font stylesheets the theme uses; the theme picker calls this again on switch.
        window.__loadThemeFonts = (theme) => {
          for (const href of fonts[theme] ?? []) {
            if (document.querySelector(`link[data-theme-font="${href}"]`)) continue;
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            link.dataset.themeFont = href;
            document.head.appendChild(link);
          }
        };
        window.__loadThemeFonts(root.dataset.theme);
      })();
    </script>
    <noscript>
      {fontManifest[defaultTheme]?.map((href) => <link rel="stylesheet" href={href} />)}
    </noscript>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Divider variant="line-brown" />
    <footer>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} W.</span>
        <div class="footer-meta-end">
          <span>记录生活的美好</span>
          <div class="footer-settings">
            <ThemePicker />
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
