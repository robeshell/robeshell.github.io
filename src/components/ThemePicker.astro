---
const themes = [
  ['minimal', '留白', '极简与秩序'],
  ['magazine', '编辑部', '纸张与版式'],
  ['terminal', '终端', '黑屏与命令'],
  ['cyber', '夜之城', '黄黑与霓虹'],
  ['island', '岛屿', '晴空与草地'],
  ['wilds', '旷野', '风沙与遗迹'],
  ['persona', '预告信', '红黑与斜切'],
];
---

<details class="theme-menu">
  <summary aria-label="切换网站主题">
    <span class="theme-preview theme-preview--minimal theme-trigger-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="theme-current">留白</span>
  </summary>

  <div class="theme-panel">
    <div class="theme-options" role="group" aria-label="网站主题">
      {themes.map(([value, label, description]) => (
        <button type="button" class="theme-option" data-theme-value={value} aria-pressed="false">
          <span class={`theme-preview theme-preview--${value}`} aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="theme-option-copy"><strong>{label}</strong><small>{description}</small></span>
          <span class="theme-check" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </div>
</details>

<script>
  const themeNames: Record<string, string> = {
    minimal: '留白', magazine: '编辑部', terminal: '终端', cyber: '夜之城', island: '岛屿', wilds: '旷野', persona: '预告信',
  };
  const themeMenu = document.querySelector<HTMLDetailsElement>('.theme-menu');
  const themeSummary = themeMenu?.querySelector<HTMLElement>('summary');
  const themeCurrent = themeMenu?.querySelector<HTMLElement>('.theme-current');
  const themeSwatch = themeMenu?.querySelector<HTMLElement>('.theme-trigger-swatch');
  const themeButtons = [...(themeMenu?.querySelectorAll<HTMLButtonElement>('[data-theme-value]') ?? [])];

  const p5TitleSelector = '.intro h1, .page-header h1, .entry-header h1, .about-page h1, .home-section-header h2, .prose h2, .site-name';
  const p5Punctuation = [' ', ',', '，', '.', '。', '!', '！', '?', '？'];

  function titleOriginal(el: HTMLElement) {
    return el.dataset.titleOriginal ?? el.textContent ?? '';
  }

  function p5InvertIndex(content: string) {
    const selected: Record<number, true> = {};
    const candidates = [...content]
      .map((ch, idx) => ({ ch, idx }))
      .filter(({ ch, idx }) => idx > 0 && !p5Punctuation.includes(ch));
    if (!candidates.length) return selected;

    // Keep the cut letters stable between renders, while giving each title its own rhythm.
    let hash = 2166136261;
    for (const ch of content) {
      hash ^= ch.charCodeAt(0);
      hash = Math.imul(hash, 16777619);
    }
    const first = candidates[(hash >>> 0) % candidates.length].idx;
    selected[first] = true;

    const shouldAddSecond = candidates.length >= 10 || (candidates.length >= 6 && (hash >>> 5) % 4 === 0);
    if (shouldAddSecond && candidates.length > 1) {
      const start = (hash >>> 8) % candidates.length;
      for (let step = 0; step < candidates.length; step++) {
        const candidate = candidates[(start + step) % candidates.length].idx;
        if (Math.abs(candidate - first) >= 3) {
          selected[candidate] = true;
          break;
        }
      }
    }
    return selected;
  }

  function wrapP5Titles() {
    document.querySelectorAll<HTMLElement>(p5TitleSelector).forEach((el) => {
      if (el.dataset.p5Wrapped === '1') return;
      const original = titleOriginal(el);
      el.dataset.titleOriginal = original;
      const invert = p5InvertIndex(original);
      const tiltPattern = [-5, 2, -3, 4, -2, 5, -4, 2, -1, 4, -3, 3];
      el.replaceChildren();
      [...original].forEach((ch, idx) => {
        const span = document.createElement('span');
        span.textContent = ch;
        span.style.setProperty('--r', `${tiltPattern[idx % tiltPattern.length]}deg`);
        if (ch === ' ') span.classList.add('is-space');
        else if (p5Punctuation.includes(ch)) span.classList.add('is-punctuation');
        if (invert[idx]) span.classList.add('is-cut');
        el.appendChild(span);
      });
      el.classList.add('p5-title');
      el.dataset.p5Wrapped = '1';
    });
  }

  function unwrapP5Titles() {
    document.querySelectorAll<HTMLElement>('[data-p5-wrapped="1"]').forEach((el) => {
      el.textContent = el.dataset.titleOriginal ?? '';
      el.classList.remove('p5-title');
      delete el.dataset.p5Wrapped;
    });
  }

  function syncTheme(theme: string) {
    const safeTheme = themeNames[theme] ? theme : 'minimal';
    document.documentElement.dataset.theme = safeTheme;
    if (themeCurrent) themeCurrent.textContent = themeNames[safeTheme];
    if (themeSwatch) themeSwatch.className = `theme-preview theme-preview--${safeTheme} theme-trigger-swatch`;
    themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeValue === safeTheme)));
    unwrapP5Titles();
    if (safeTheme === 'persona') wrapP5Titles();
  }

  syncTheme(document.documentElement.dataset.theme ?? 'minimal');

  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const theme = button.dataset.themeValue ?? 'minimal';
      syncTheme(theme);
      try { localStorage.setItem('site-theme', theme); } catch { /* Keep the in-page choice. */ }
      if (themeMenu) themeMenu.open = false;
      themeSummary?.focus({ preventScroll: true });
      window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
    });
  });

  document.addEventListener('click', (event) => {
    if (themeMenu?.open && !themeMenu.contains(event.target as Node)) themeMenu.open = false;
  });

  themeMenu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      themeMenu.open = false;
      themeSummary?.focus();
    }
  });
</script>
