---
import type { CollectionEntry } from 'astro:content';
import { ENTRY_ARROW_PATH, ENTRY_ARROW_WILDS_PATH } from '../scripts/aether-markup.js';
import { sections } from '../lib/sections';

interface Props {
  entries: CollectionEntry<'entries'>[];
  showSection?: boolean;
}

const { entries, showSection = false } = Astro.props;
---

<ol class="entry-list">
  {entries.map((entry) => (
    <li>
      <a href={`/${entry.data.section}/${entry.id}/`}>
        <span class="entry-card-shell" aria-hidden="true"></span>
        <h2>{entry.data.title}</h2>
        <span class="entry-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d={ENTRY_ARROW_PATH} />
          </svg>
        </span>
        <span class="entry-arrow entry-arrow--wilds" aria-hidden="true">
          <svg viewBox="0 0 10 18" focusable="false">
            <path d={ENTRY_ARROW_WILDS_PATH} />
          </svg>
        </span>
        <div class="list-meta">
          {showSection && <span>{sections[entry.data.section].label}</span>}
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
          </time>
        </div>
        <p>{entry.data.description}</p>
      </a>
    </li>
  ))}
</ol>
