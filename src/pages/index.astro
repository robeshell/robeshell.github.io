---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import CardList from '../components/CardList.astro';
import { buildTopicView, getEntries, getTopics, topicStatus } from '../lib/content';

const entries = await getEntries();
// Drafts (including the example templates) never appear in the homepage feed, even locally.
const latest = entries.filter((entry) => !entry.data.draft).slice(0, 6);
const learning = (await getTopics())
  .filter((topic) => topic.data.status === 'learning')
  .map((topic) => buildTopicView(topic, entries))
  .map(({ topic, progress, updated }) => ({
    href: `/topics/${topic.id}/`,
    title: topic.data.title,
    description: topic.data.description,
    labels: [topicStatus[topic.data.status], `${progress.written} / ${progress.total} 章`],
    date: updated,
    detail: '尚未开始',
    progress: progress.total ? progress.written / progress.total : 0,
  }));
---

<BaseLayout>
  <section class="intro">
    <h1>写下一些值得留下的事。</h1>
    <p>这里存放我的文章、学习笔记、旅行、照片和音乐。没有固定主题，只记录持续关心的东西。</p>
  </section>

  <section class="home-section">
    <div class="home-section-header">
      <h2>最近更新</h2>
      <a href="/writing/">浏览全部</a>
    </div>
    <EntryList entries={latest} showSection />
  </section>

  {learning.length > 0 && (
    <section class="home-section">
      <div class="home-section-header">
        <h2>正在学</h2>
        <a href="/topics/">全部专题</a>
      </div>
      <CardList items={learning} variant="topics" />
    </section>
  )}
</BaseLayout>
